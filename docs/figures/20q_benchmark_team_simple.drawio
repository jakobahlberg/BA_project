<mxfile host="Electron" modified="2026-05-13T13:50:00.000Z" agent="Claude" version="29.7.9">
  <diagram name="Multi-Agent-Guesser" id="diag1">
    <mxGraphModel dx="1240" dy="560" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============== ANALYST sub-agent (emerald) ============== -->
        <mxCell id="analyst" value="&lt;b style=&quot;font-size:17px;color:#065F46&quot;&gt;ANALYST&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-style:italic&quot;&gt;agent-as-tool&lt;/span&gt;&lt;hr style=&quot;border:none;border-top:1px solid #6EE7B7;margin:8px 10px&quot;&gt;&lt;div style=&quot;font-size:12.5px;color:#0F172A;line-height:1.55&quot;&gt;reads the transcript,&lt;br&gt;tracks the belief state,&lt;br&gt;narrows the candidate set&lt;/div&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=3;align=center;verticalAlign=top;fontSize=12;spacing=16;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="90" width="280" height="160" as="geometry" />
        </mxCell>

        <!-- ============== RESEARCHER sub-agent (amber) ============== -->
        <mxCell id="researcher" value="&lt;b style=&quot;font-size:17px;color:#92400E&quot;&gt;RESEARCHER&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-style:italic&quot;&gt;agent-as-tool&lt;/span&gt;&lt;hr style=&quot;border:none;border-top:1px solid #FCD34D;margin:8px 10px&quot;&gt;&lt;div style=&quot;font-size:12.5px;color:#0F172A;line-height:1.55&quot;&gt;searches public 20-Q games,&lt;br&gt;mines common strategies,&lt;br&gt;proposes high-yield splits&lt;/div&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=3;align=center;verticalAlign=top;fontSize=12;spacing=16;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="310" width="280" height="160" as="geometry" />
        </mxCell>

        <!-- ============== ORCHESTRATOR (blue, center, large) ============== -->
        <mxCell id="orchestrator" value="&lt;b style=&quot;font-size:20px;color:#1E3A8A&quot;&gt;ORCHESTRATOR&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#475569;font-style:italic&quot;&gt;the Guesser&lt;/span&gt;&lt;hr style=&quot;border:none;border-top:1px solid #93C5FD;margin:10px 18px&quot;&gt;&lt;div style=&quot;text-align:left;font-size:13.5px;line-height:1.85;color:#0F172A;padding:0 18px&quot;&gt;each turn, pick ONE:&lt;br&gt;&amp;nbsp;&amp;nbsp;• &lt;tt&gt;CALL ANALYST&lt;/tt&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;• &lt;tt&gt;CALL RESEARCHER&lt;/tt&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;• &lt;tt&gt;USE_HINT&lt;/tt&gt; &amp;nbsp;/&amp;nbsp; &lt;tt&gt;WEB_SEARCH&lt;/tt&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;• &lt;tt&gt;QUESTION&lt;/tt&gt; &amp;nbsp;/&amp;nbsp; &lt;tt&gt;GUESS&lt;/tt&gt;&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=3.5;align=center;verticalAlign=top;fontSize=13;spacing=18;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="130" width="320" height="300" as="geometry" />
        </mxCell>

        <!-- ============== Tool chips (same color: sky/cyan) ============== -->
        <mxCell id="hint" value="&lt;b style=&quot;color:#155E75&quot;&gt;USE_HINT&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#CFFAFE;strokeColor=#0891B2;strokeWidth=2;align=center;verticalAlign=middle;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="495" y="460" width="130" height="44" as="geometry" />
        </mxCell>
        <mxCell id="web" value="&lt;b style=&quot;color:#155E75&quot;&gt;WEB_SEARCH&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#CFFAFE;strokeColor=#0891B2;strokeWidth=2;align=center;verticalAlign=middle;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="645" y="460" width="140" height="44" as="geometry" />
        </mxCell>

        <!-- ============== SECRET KEEPER (purple) ============== -->
        <mxCell id="secret" value="&lt;b style=&quot;font-size:18px;color:#5B21B6&quot;&gt;SECRET KEEPER&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#475569;font-style:italic&quot;&gt;guards the secret word&lt;/span&gt;&lt;hr style=&quot;border:none;border-top:1px solid #C4B5FD;margin:10px 16px&quot;&gt;&lt;div style=&quot;text-align:left;font-size:13.5px;line-height:1.85;color:#0F172A;padding:0 20px&quot;&gt;one-word reply:&lt;br&gt;&amp;nbsp;&amp;nbsp;• &lt;tt&gt;YES&lt;/tt&gt; &amp;nbsp;/&amp;nbsp; &lt;tt&gt;NO&lt;/tt&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;• &lt;tt&gt;CORRECT&lt;/tt&gt; &amp;nbsp;/&amp;nbsp; &lt;tt&gt;WRONG&lt;/tt&gt;&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=3.5;align=center;verticalAlign=top;fontSize=13;spacing=18;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="175" width="290" height="210" as="geometry" />
        </mxCell>

        <!-- ============== EDGES — bidirectional, horizontal/vertical ============== -->

        <!-- Analyst ↔ Orchestrator  (horizontal at y=200) -->
        <mxCell id="a_orch" style="endArrow=classic;endFill=1;startArrow=classic;startFill=1;html=1;rounded=0;strokeColor=#059669;strokeWidth=2.5;exitX=1;exitY=0.6875;exitDx=0;exitDy=0;entryX=0;entryY=0.233;entryDx=0;entryDy=0;" edge="1" parent="1" source="analyst" target="orchestrator">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Researcher ↔ Orchestrator  (horizontal at y=380) -->
        <mxCell id="r_orch" style="endArrow=classic;endFill=1;startArrow=classic;startFill=1;html=1;rounded=0;strokeColor=#D97706;strokeWidth=2.5;exitX=1;exitY=0.4375;exitDx=0;exitDy=0;entryX=0;entryY=0.833;entryDx=0;entryDy=0;" edge="1" parent="1" source="researcher" target="orchestrator">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Orchestrator ↔ Secret keeper  (horizontal at y=280) -->
        <mxCell id="orch_secret" style="endArrow=classic;endFill=1;startArrow=classic;startFill=1;html=1;rounded=0;strokeColor=#1E3A8A;strokeWidth=3.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="orchestrator" target="secret">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Orchestrator → USE_HINT  (vertical dashed) -->
        <mxCell id="o_hint" style="endArrow=classic;html=1;rounded=0;dashed=1;strokeColor=#0E7490;strokeWidth=1.8;exitX=0.3125;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="orchestrator" target="hint">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Orchestrator → WEB_SEARCH  (vertical dashed) -->
        <mxCell id="o_web" style="endArrow=classic;html=1;rounded=0;dashed=1;strokeColor=#0E7490;strokeWidth=1.8;exitX=0.7969;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="orchestrator" target="web">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
