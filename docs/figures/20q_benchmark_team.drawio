        <!-- Orchestrator (the guesser brain) -->
        <mxCell id="orchestrator" value="&lt;b style=&quot;font-size:18px;color:#1E3A8A&quot;&gt;ORCHESTRATOR  (Guesser)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#475569;font-size:13px&quot;&gt;size × bit-width&lt;/span&gt;&lt;hr style=&quot;border:none;border-top:1px solid #93C5FD;margin:8px 0&quot;&gt;&lt;div style=&quot;text-align:left;font-size:13.5px;line-height:1.6;color:#0F172A&quot;&gt;each turn, picks ONE action:&lt;br&gt;&amp;nbsp;&amp;nbsp;• &lt;tt&gt;CALL ANALYST(prompt)&lt;/tt&gt; &amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#64748B;font-style:italic&quot;&gt;agent-as-tool&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;• &lt;tt&gt;CALL RESEARCHER(prompt)&lt;/tt&gt; &amp;nbsp;&lt;span style=&quot;color:#64748B;font-style:italic&quot;&gt;agent-as-tool&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;• &lt;tt&gt;USE_HINT&lt;/tt&gt; &amp;nbsp;/&amp;nbsp; &lt;tt&gt;WEB_SEARCH:⟨q⟩&lt;/tt&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;• &lt;tt&gt;QUESTION:&lt;/tt&gt; &lt;i&gt;yes/no question&lt;/i&gt; &amp;nbsp;&lt;span style=&quot;color:#1E3A8A;font-weight:600&quot;&gt;→ keeper&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;• &lt;tt&gt;GUESS:&lt;/tt&gt; &lt;i&gt;specific name&lt;/i&gt; &amp;nbsp;&lt;span style=&quot;color:#1E3A8A;font-weight:600&quot;&gt;→ keeper&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BFDBFE;strokeColor=#1D4ED8;strokeWidth=2.5;align=center;verticalAlign=top;fontSize=13;spacing=12;" vertex="1" parent="1">
